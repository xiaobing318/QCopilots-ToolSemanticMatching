{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaobing318/QCopilots-ToolSemanticMatching/main/schemas/search-request.schema.json",
  "title": "QCTSM natural-language search request v1",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": {"type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S"},
    "top_n": {"type": "integer", "minimum": 1, "maximum": 100, "default": 8},
    "filters": {
      "type": "object",
      "properties": {
        "source_id": {"type": "string"},
        "kind": {"enum": ["definition", "example"]},
        "available": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
