include_guard(GLOBAL)
if(TARGET SQLite3::SQLite3)
  if(NOT TARGET SQLite::SQLite3)
    add_library(SQLite::SQLite3 ALIAS SQLite3::SQLite3)
  endif()
  return()
endif()
include(FetchContent)
FetchContent_Declare(qctsm_sqlite
  URL https://sqlite.org/2026/sqlite-amalgamation-3530400.zip
  URL_HASH SHA256=1e71ddf93849c6a6ecf58b827c0692073d2dd7ee40196158068f7b29f422e87d
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_GetProperties(qctsm_sqlite)
if(NOT qctsm_sqlite_POPULATED)
  FetchContent_Populate(qctsm_sqlite)
endif()
add_library(qctsm-sqlite STATIC "${qctsm_sqlite_SOURCE_DIR}/sqlite3.c")
set_target_properties(qctsm-sqlite PROPERTIES AUTOMOC OFF AUTORCC OFF)
target_include_directories(qctsm-sqlite SYSTEM PUBLIC "${qctsm_sqlite_SOURCE_DIR}")
target_compile_definitions(qctsm-sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_DQS=0 SQLITE_DEFAULT_FOREIGN_KEYS=1 SQLITE_OMIT_LOAD_EXTENSION)
if(UNIX)
  find_package(Threads REQUIRED)
  target_link_libraries(qctsm-sqlite PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
  if(NOT APPLE)
    target_link_libraries(qctsm-sqlite PUBLIC m)
  endif()
endif()
add_library(SQLite3::SQLite3 ALIAS qctsm-sqlite)
add_library(SQLite::SQLite3 ALIAS qctsm-sqlite)
