include_guard(GLOBAL)

# Candidate metadata is inside each user package, never an extra CI artifact.
set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT "" CACHE STRING "Complete immutable candidate Git commit, or empty for a local build")
set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_ATTEMPT "1" CACHE STRING "Original CI run attempt that produced this package")
set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_RUN_ID "" CACHE STRING "GitHub run ID, or empty for a local build")
set(_qctsm_package_run "null")
if(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_RUN_ID STREQUAL "")
  if(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_RUN_ID MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "CI run ID must be a positive decimal string")
  endif()
  set(_qctsm_package_run "\"${QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_RUN_ID}\"")
endif()
if(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_ATTEMPT MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_ATTEMPT must be a positive integer")
endif()
if(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT MATCHES "^[a-z0-9][a-z0-9.-]*$")
  message(FATAL_ERROR "Package identity requires a valid QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT")
endif()
file(READ "${PROJECT_SOURCE_DIR}/config/build-variants.json" _qctsm_variants_json)
string(JSON _qctsm_variant_count LENGTH "${_qctsm_variants_json}" variants)
math(EXPR _qctsm_variant_last "${_qctsm_variant_count} - 1")
set(_qctsm_package_backend "")
foreach(_qctsm_variant_index RANGE ${_qctsm_variant_last})
  string(JSON _qctsm_variant_id GET "${_qctsm_variants_json}" variants ${_qctsm_variant_index} id)
  if(_qctsm_variant_id STREQUAL QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT)
    string(JSON _qctsm_package_backend GET "${_qctsm_variants_json}" variants ${_qctsm_variant_index} backend)
    string(JSON _qctsm_package_variant GET "${_qctsm_variants_json}" variants ${_qctsm_variant_index} packageVariant)
    string(JSON _qctsm_package_toolkit GET "${_qctsm_variants_json}" variants ${_qctsm_variant_index} toolkitVersion)
  endif()
endforeach()
if(_qctsm_package_backend STREQUAL "")
  message(FATAL_ERROR "Unknown package variant: ${QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT}")
endif()
set(_qctsm_package_commit "null")
set(_qctsm_package_modified "null")
set(_qctsm_package_revision "local-source")
find_package(Git QUIET)
if(Git_FOUND AND EXISTS "${PROJECT_SOURCE_DIR}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --verify HEAD
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" RESULT_VARIABLE _qctsm_git_status
    OUTPUT_VARIABLE _qctsm_head OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" RESULT_VARIABLE _qctsm_status_status
    OUTPUT_VARIABLE _qctsm_dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _qctsm_git_status EQUAL 0 OR NOT _qctsm_status_status EQUAL 0)
    if(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT STREQUAL "")
      message(FATAL_ERROR "Cannot determine immutable package source identity")
    endif()
    set(_qctsm_head "0000000000000000000000000000000000000000")
    set(_qctsm_dirty "uncommitted initial checkout")
  endif()
  set(_qctsm_package_commit "\"${_qctsm_head}\"")
  string(SUBSTRING "${_qctsm_head}" 0 12 _qctsm_package_revision)
  set(_qctsm_package_modified false)
  if(NOT _qctsm_dirty STREQUAL "")
    set(_qctsm_package_modified true)
    if(QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT STREQUAL "")
      string(APPEND _qctsm_package_revision "-dirty")
    endif()
  endif()
endif()
if(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT STREQUAL "")
  string(LENGTH "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT}" _qctsm_commit_length)
  if(NOT _qctsm_commit_length EQUAL 40 OR NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT requires the complete lowercase Git SHA")
  endif()
  if(NOT _qctsm_head STREQUAL QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_COMMIT OR NOT _qctsm_package_modified STREQUAL "false")
    message(FATAL_ERROR "Immutable candidate packaging requires the matching clean Git checkout")
  endif()
endif()
file(SHA256 "${PROJECT_SOURCE_DIR}/dependencies.lock.json" _qctsm_dependency_sha)
file(SHA256 "${PROJECT_SOURCE_DIR}/config/build-variants.json" _qctsm_variants_sha)
file(SHA256 "${PROJECT_SOURCE_DIR}/config/gpu-sdk.lock.json" _qctsm_gpu_sdk_sha)
file(SHA256 "${PROJECT_SOURCE_DIR}/config/gpu-license-sources.lock.json" _qctsm_gpu_license_sha)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/qctsm-build-identity-$<CONFIG>.json" CONTENT
"{\n  \"schemaVersion\": 1,\n  \"version\": \"${PROJECT_VERSION}\",\n  \"variant\": \"${QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT}\",\n  \"packageVariant\": \"${_qctsm_package_variant}\",\n  \"toolkitVersion\": \"${_qctsm_package_toolkit}\",\n  \"backend\": \"${_qctsm_package_backend}\",\n  \"configuration\": \"$<CONFIG>\",\n  \"candidateCommit\": ${_qctsm_package_commit},\n  \"workingTreeModified\": ${_qctsm_package_modified},\n  \"runId\": ${_qctsm_package_run},\n  \"attempt\": ${QCOPILOTS_TOOL_SEMANTIC_MATCHING_CANDIDATE_ATTEMPT},\n  \"dependencyLockSha256\": \"${_qctsm_dependency_sha}\",\n  \"variantsSha256\": \"${_qctsm_variants_sha}\",\n  \"gpuSdkLockSha256\": \"${_qctsm_gpu_sdk_sha}\",\n  \"gpuLicenseLockSha256\": \"${_qctsm_gpu_license_sha}\"\n}\n")
