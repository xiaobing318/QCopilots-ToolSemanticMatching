# Adapted from QCopilots-Search runtime build (MIT, xbyang).
# Only the application opts into this module. The shared SDK never includes it.
include_guard(GLOBAL)
if(NOT COMMAND qctsm_require_external_path)
  function(qctsm_require_external_path name value)
    get_filename_component(_path "${value}" ABSOLUTE)
    file(REAL_PATH "${PROJECT_SOURCE_DIR}" _source)
    cmake_path(IS_PREFIX _source "${_path}" NORMALIZE _inside)
    if(_inside)
      message(FATAL_ERROR "${name} must be outside the source checkout: ${value}")
    endif()
  endfunction()
endif()
# Runtime dependencies are always built outside the checkout.
include(FetchContent)
find_package(Git REQUIRED)
find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
include("${PROJECT_SOURCE_DIR}/cmake/qctsm-gpu-variants.cmake")
qctsm_select_variant()
file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" _qctsm_dependency_lock)
string(JSON _qctsm_llama_commit GET "${_qctsm_dependency_lock}" "llama.cpp" commit)
string(JSON _qctsm_llama_url GET "${_qctsm_dependency_lock}" "llama.cpp" url)
string(JSON _qctsm_llama_sha GET "${_qctsm_dependency_lock}" "llama.cpp" sha256)
string(SUBSTRING "${_qctsm_llama_sha}" 0 12 _qctsm_llama_cache_id)
set(LLAMA_BUILD_COMMIT "${_qctsm_llama_commit}" CACHE STRING "Locked upstream source identity" FORCE)
set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND}" CACHE INTERNAL "Backend selected by the product variant" FORCE)

set(BUILD_SHARED_LIBS ON)
set(_qcopilots_cpu_dispatch OFF)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
  set(_qcopilots_cpu_dispatch ON)
  set(BUILD_SHARED_LIBS ON)
endif()
set(GGML_NATIVE OFF CACHE BOOL "Portable CPU instruction baseline" FORCE)
if(WIN32)
  # Upstream auto-detection sets a global launcher, including application
  # targets. The hosted Windows ccache loses Unicode source paths with MSVC.
  set(GGML_CCACHE OFF CACHE BOOL "Preserve Windows Unicode paths without an implicit compiler launcher" FORCE)
endif()
foreach(_instruction SSE42 AVX AVX2 AVX_VNNI AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 FMA F16C BMI2)
  set(GGML_${_instruction} OFF CACHE BOOL "Portable x64 baseline" FORCE)
endforeach()
foreach(_backend METAL CUDA VULKAN HIP)
  set(GGML_${_backend} OFF CACHE BOOL "Selected by the QCTSM product variant" FORCE)
endforeach()
if(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND STREQUAL "metal")
  set(GGML_METAL ON CACHE BOOL "Metal product variant" FORCE)
  set(GGML_METAL_EMBED_LIBRARY ON CACHE BOOL "Ship Metal shaders inside the backend" FORCE)
elseif(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND STREQUAL "vulkan")
  set(GGML_VULKAN ON CACHE BOOL "Vulkan product variant" FORCE)
elseif(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND STREQUAL "cuda" AND NOT WIN32)
  set(GGML_CUDA ON CACHE BOOL "CUDA product variant" FORCE)
  set(GGML_CUDA_NCCL OFF CACHE BOOL "Match upstream release recipe" FORCE)
  set(GGML_CUDA_CCCL_VERSION v3.4.3 CACHE STRING "Match the pinned upstream release" FORCE)
elseif(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND STREQUAL "hip" AND NOT WIN32)
  set(GGML_HIP ON CACHE BOOL "ROCm product variant" FORCE)
  set(GPU_TARGETS "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_TARGETS}" CACHE STRING "Published RDNA4 coverage" FORCE)
endif()
set(GGML_SYCL OFF CACHE BOOL "CPU baseline" FORCE)
set(GGML_OPENCL OFF CACHE BOOL "CPU baseline" FORCE)
set(GGML_BLAS OFF CACHE BOOL "CPU baseline" FORCE)
set(GGML_BACKEND_DL ON CACHE BOOL "Load the packaged CPU and GPU backends" FORCE)
set(GGML_CPU_ALL_VARIANTS ${_qcopilots_cpu_dispatch} CACHE BOOL "Portable baseline plus accelerated CPU backends" FORCE)
set(LLAMA_BUILD_IS_DEV OFF CACHE BOOL "Pinned inference build" FORCE)
set(LLAMA_BUILD_COMMON OFF CACHE BOOL "Only embedding libraries" FORCE)
set(LLAMA_BUILD_TESTS OFF CACHE BOOL "Application owns regression tests" FORCE)
set(LLAMA_BUILD_TOOLS OFF CACHE BOOL "Only embedding libraries" FORCE)
set(LLAMA_BUILD_EXAMPLES OFF CACHE BOOL "Only embedding libraries" FORCE)
set(LLAMA_BUILD_SERVER OFF CACHE BOOL "No inference network service" FORCE)
set(LLAMA_BUILD_APP OFF CACHE BOOL "Only embedding libraries" FORCE)
set(LLAMA_BUILD_UI OFF CACHE BOOL "No inference web UI" FORCE)
set(LLAMA_BUILD_MTMD OFF CACHE BOOL "Text-only embedding library" FORCE)
set(LLAMA_OPENSSL OFF CACHE BOOL "Models are downloaded by the application" FORCE)
set(LLAMA_SUBPROCESS OFF CACHE BOOL "Use application's controlled media extraction" FORCE)
set(MTMD_VIDEO OFF CACHE BOOL "No external ffmpeg subprocess lookup" FORCE)

set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_SOURCE_DIR "" CACHE PATH "Existing checkout or verified source archive of the pinned llama.cpp commit")
set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_BINARY_DIR "${CMAKE_BINARY_DIR}/nd/llama" CACHE PATH "Configuration-specific inference build directory")
qctsm_require_external_path(QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_BINARY_DIR "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_BINARY_DIR}")
if(QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_SOURCE_DIR)
  qctsm_require_external_path(QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_SOURCE_DIR "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_SOURCE_DIR}")
  set(FETCHCONTENT_SOURCE_DIR_QCTSM_LLAMA "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_SOURCE_DIR}")
endif()
if(FETCHCONTENT_SOURCE_DIR_QCTSM_LLAMA)
  qctsm_require_external_path(FETCHCONTENT_SOURCE_DIR_QCTSM_LLAMA "${FETCHCONTENT_SOURCE_DIR_QCTSM_LLAMA}")
  set(_qcopilots_llama_lock "${FETCHCONTENT_SOURCE_DIR_QCTSM_LLAMA}.qctsm.lock")
else()
  file(MAKE_DIRECTORY "${FETCHCONTENT_BASE_DIR}")
  set(_qcopilots_llama_lock "${FETCHCONTENT_BASE_DIR}/qctsm-llama-${_qctsm_llama_cache_id}.lock")
endif()
file(LOCK "${_qcopilots_llama_lock}" GUARD FILE TIMEOUT 300 RESULT_VARIABLE _qcopilots_llama_lock_result)
if(NOT _qcopilots_llama_lock_result STREQUAL "0")
  message(FATAL_ERROR "Cannot lock shared llama.cpp dependency: ${_qcopilots_llama_lock_result}")
endif()
FetchContent_Declare(qctsm_llama
  URL "${_qctsm_llama_url}"
  URL_HASH "SHA256=${_qctsm_llama_sha}"
  TIMEOUT 600
  INACTIVITY_TIMEOUT 60
  DOWNLOAD_DIR "${FETCHCONTENT_BASE_DIR}/downloads"
  DOWNLOAD_NAME "llama-${_qctsm_llama_cache_id}.tar.gz"
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
  SOURCE_DIR "${FETCHCONTENT_BASE_DIR}/qctsm-llama-${_qctsm_llama_cache_id}-src"
  BINARY_DIR "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_BINARY_DIR}"
  SUBBUILD_DIR "${CMAKE_BINARY_DIR}/sb/llama")
FetchContent_GetProperties(qctsm_llama)
if(NOT qctsm_llama_POPULATED)
  FetchContent_Populate(qctsm_llama)
endif()
set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_LLAMA_SOURCE_DIR "${qctsm_llama_SOURCE_DIR}" CACHE PATH "Verified locked upstream source directory" FORCE)
include("${CMAKE_CURRENT_LIST_DIR}/qctsm-llama-verify.cmake")
qctsm_verify_llama_source("${qctsm_llama_SOURCE_DIR}")
# EXCLUDE_FROM_ALL prevents upstream developer headers/tools from entering application packages.
# Inference has no Qt sources. Keep this scope local so our runtime below still
# gets Qt autogen, without generating *_autogen trees for every CPU variant.
block(SCOPE_FOR VARIABLES)
  set(CMAKE_AUTOMOC OFF)
  set(CMAKE_AUTORCC OFF)
  set(CMAKE_AUTOUIC OFF)
  # ggml's optional Git lookup overwrites the parent-supplied commit for source
  # archives. Keep the verified lock identity instead of probing an absent .git.
  set(GIT_EXE OFF)
  add_subdirectory("${qctsm_llama_SOURCE_DIR}" "${qctsm_llama_BINARY_DIR}" EXCLUDE_FROM_ALL)
endblock()
qctsm_verify_llama_source("${qctsm_llama_SOURCE_DIR}")
file(LOCK "${_qcopilots_llama_lock}" RELEASE)


function(qctsm_finalize_llama consumer)
  target_compile_definitions(${consumer} PRIVATE QCTSM_GPU_BACKEND="${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND}" QCTSM_BUILD_VARIANT="${QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT}")
include("${PROJECT_SOURCE_DIR}/cmake/qctsm-gpu-backend.cmake")
qctsm_add_windows_gpu_backend("${qctsm_llama_SOURCE_DIR}" _qcopilots_external_gpu)
set(_qcopilots_gpu_libraries)
if(_qcopilots_external_gpu)
  list(APPEND _qcopilots_gpu_libraries "${_qcopilots_external_gpu}")
  add_dependencies(${consumer} qctsm-gpu-backend-abi)
elseif(NOT QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND STREQUAL "cpu")
  if(NOT TARGET "ggml-${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND}")
    message(FATAL_ERROR "Requested ${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND} backend was not created by llama.cpp")
  endif()
  list(APPEND _qcopilots_gpu_libraries "ggml-${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND}")
endif()
if(_qcopilots_cpu_dispatch)
  target_compile_definitions(${consumer} PRIVATE QCTSM_CPU_DISPATCH=1)
  set(_qcopilots_runtime_libraries llama ggml ggml-base)
  set(_qcopilots_cpu_libraries)
  foreach(_variant x64 sse42 sandybridge ivybridge piledriver haswell skylakex cannonlake cascadelake icelake cooperlake zen4 alderlake sapphirerapids)
    if(TARGET ggml-cpu-${_variant})
      list(APPEND _qcopilots_cpu_libraries ggml-cpu-${_variant})
    endif()
  endforeach()
else()
  set(_qcopilots_runtime_libraries llama ggml ggml-base)
  set(_qcopilots_cpu_libraries ggml-cpu)
endif()
include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/qctsm-llama-guard.cmake")
qctsm_llama_build_targets("${qctsm_llama_SOURCE_DIR}" _qcopilots_source_targets)
set(_qcopilots_built_targets ${_qcopilots_runtime_libraries} ${_qcopilots_cpu_libraries})
if(_qcopilots_external_gpu)
  list(APPEND _qcopilots_source_targets qctsm-gpu-backend-build)
  list(APPEND _qcopilots_built_targets qctsm-gpu-backend-build)
else()
  list(APPEND _qcopilots_built_targets ${_qcopilots_gpu_libraries})
endif()
qctsm_guard_llama_source("${qctsm_llama_SOURCE_DIR}"
  SOURCE_TARGETS ${_qcopilots_source_targets}
  BUILT_TARGETS ${_qcopilots_built_targets}
  CONSUMER_TARGETS ${consumer})
set_property(GLOBAL PROPERTY QCOPILOTS_TOOL_SEMANTIC_MATCHING_INFERENCE_RUNTIME_TARGETS "${_qcopilots_runtime_libraries};${_qcopilots_cpu_libraries};${_qcopilots_gpu_libraries}")
set_property(GLOBAL PROPERTY QCOPILOTS_TOOL_SEMANTIC_MATCHING_INFERENCE_CPU_RUNTIME_TARGETS "${_qcopilots_cpu_libraries}")
set_property(GLOBAL PROPERTY QCOPILOTS_TOOL_SEMANTIC_MATCHING_INFERENCE_GPU_RUNTIME_TARGETS "${_qcopilots_gpu_libraries}")
include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/qctsm-llama-install.cmake")
qctsm_install_inference_runtime(
  LIBRARIES ${_qcopilots_runtime_libraries} CPU_BACKENDS ${_qcopilots_cpu_libraries}
  GPU_BACKENDS ${_qcopilots_gpu_libraries})
foreach(_gpu IN LISTS _qcopilots_gpu_libraries)
  qctsm_install_gpu_dependencies("${_gpu}")
endforeach()

endfunction()
