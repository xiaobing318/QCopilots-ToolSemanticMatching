set(CPACK_PACKAGE_CONTACT "https://github.com/xiaobing318/QCopilots-ToolSemanticMatching/issues")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Local multilingual tool and algorithm semantic matching")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "qctsm")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/../pkg/${CMAKE_BUILD_TYPE}" CACHE PATH "External package directory")
set(CPACK_PACKAGE_FILE_NAME "qctsm-${PROJECT_VERSION}-${_qctsm_package_variant}")
set(CPACK_QCTSM_SOURCE_DIR "${PROJECT_SOURCE_DIR}")
set(CPACK_QCTSM_PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
set(CPACK_QCTSM_VARIANT "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT}")
set(CPACK_QCTSM_SYSTEM_NAME "${CMAKE_SYSTEM_NAME}")
set(CPACK_QCTSM_GPU_BACKEND "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND}")
set(CPACK_QCTSM_GPU_SDK_MANIFEST "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_SDK_MANIFEST}")
set(CPACK_QCTSM_BUILD_DIR "${CMAKE_BINARY_DIR}")
set(CPACK_QCTSM_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
set(CPACK_QCTSM_BUILD_TYPE "${CMAKE_BUILD_TYPE}")
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/qctsm-cpack.cmake")
set(CPACK_STRIP_FILES TRUE)
if(WIN32)
  set(CPACK_GENERATOR "NSIS;ZIP")
  set(CPACK_NSIS_DISPLAY_NAME "QCopilots Tool Semantic Matching")
  set(CPACK_NSIS_PACKAGE_NAME "QCopilots Tool Semantic Matching")
  set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\\\qctsm-gui.exe")
  set(CPACK_NSIS_EXECUTABLES_DIRECTORY bin)
  set(CPACK_PACKAGE_EXECUTABLES "qctsm-gui" "QCopilots Tool Semantic Matching")
  set(CPACK_NSIS_INSTALL_ROOT "$LOCALAPPDATA/Programs")
  set(CPACK_NSIS_EXECUTION_LEVEL user)
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL OFF)
elseif(APPLE)
  set(CPACK_GENERATOR DragNDrop)
  set(CPACK_STRIP_FILES FALSE)
else()
  set(CPACK_GENERATOR "TGZ;DEB")
  set(CPACK_PACKAGING_INSTALL_PREFIX "/opt/qctsm")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "QCopilots contributors")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_SECTION science)
endif()
include(CPack)
