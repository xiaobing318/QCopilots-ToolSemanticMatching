# Package deployment adapted from QCopilots-Search (MIT).
include_guard(GLOBAL)
include(GNUInstallDirs)
include(qctsm-licenses)

if(APPLE)
  set_target_properties(qctsm-gui PROPERTIES
    MACOSX_BUNDLE TRUE
    MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_LIST_DIR}/qctsm-Info.plist.in"
    MACOSX_BUNDLE_GUI_IDENTIFIER "com.qcopilots.toolsemanticmatching"
    MACOSX_BUNDLE_BUNDLE_NAME "QCopilots Tool Semantic Matching"
    MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}"
    MACOSX_BUNDLE_SHORT_VERSION_STRING "${PROJECT_VERSION}")
endif()

if(MSVC)
  set(CMAKE_INSTALL_OPENMP_LIBRARIES TRUE)
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION "${CMAKE_INSTALL_BINDIR}")
  include(InstallRequiredSystemLibraries)
endif()

foreach(_program qctsm-gui qctsm-service qctsm-worker qctsm-cli)
  if(NOT TARGET ${_program})
    message(FATAL_ERROR "A product distribution requires ${_program}")
  endif()
  if(APPLE AND NOT _program STREQUAL "qctsm-gui")
    install(TARGETS ${_program} RUNTIME DESTINATION "qctsm-gui.app/Contents/MacOS")
  else()
    install(TARGETS ${_program} RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} BUNDLE DESTINATION .)
  endif()
endforeach()

option(QCOPILOTS_TOOL_SEMANTIC_MATCHING_DEPLOY_QT "Bundle Qt dependencies in product packages" ON)
if(QCOPILOTS_TOOL_SEMANTIC_MATCHING_DEPLOY_QT)
  set(_qctsm_modules "")
  if(TARGET Qt6::QOffscreenIntegrationPlugin)
    if(APPLE)
      set(_qctsm_platform_dir "qctsm-gui.app/Contents/PlugIns/platforms")
    else()
      set(_qctsm_platform_dir "plugins/platforms")
    endif()
    install(FILES "$<TARGET_FILE:Qt6::QOffscreenIntegrationPlugin>" DESTINATION "${_qctsm_platform_dir}")
    string(APPEND _qctsm_modules " \"$<TARGET_FILE:Qt6::QOffscreenIntegrationPlugin>\"")
  endif()
  set(_qctsm_extra)
  foreach(_helper qctsm-service qctsm-worker qctsm-cli)
    if(APPLE)
      string(APPEND _qctsm_extra " \"\${QT_DEPLOY_PREFIX}/qctsm-gui.app/Contents/MacOS/$<TARGET_FILE_NAME:${_helper}>\"")
    else()
      string(APPEND _qctsm_extra " \"$<TARGET_FILE:${_helper}>\"")
    endif()
  endforeach()
  set(_qctsm_libraries "")
  set(_qctsm_excluded "")
  get_property(_qctsm_gpu_targets GLOBAL PROPERTY QCOPILOTS_TOOL_SEMANTIC_MATCHING_INFERENCE_GPU_RUNTIME_TARGETS)
  foreach(_property INFERENCE_RUNTIME_TARGETS INFERENCE_CPU_RUNTIME_TARGETS)
    get_property(_qctsm_targets GLOBAL PROPERTY QCOPILOTS_TOOL_SEMANTIC_MATCHING_${_property})
    if(UNIX AND NOT APPLE AND _qctsm_gpu_targets)
      # GPU SDK closures are already deployed by qctsm-gpu-runtime. Flattening
      # ROCm's component libraries here breaks relative BLAS resource lookup.
      list(REMOVE_ITEM _qctsm_targets ${_qctsm_gpu_targets})
    endif()
    foreach(_target IN LISTS _qctsm_targets)
      if(TARGET ${_target})
        get_target_property(_type ${_target} TYPE)
        if(_type STREQUAL "SHARED_LIBRARY")
          string(APPEND _qctsm_libraries " \"$<TARGET_FILE:${_target}>\"")
        elseif(_type STREQUAL "MODULE_LIBRARY")
          string(APPEND _qctsm_modules " \"$<TARGET_FILE:${_target}>\"")
        endif()
        string(APPEND _qctsm_excluded " \"$<TARGET_FILE:${_target}>\"")
      endif()
    endforeach()
  endforeach()
  set(_qctsm_deploy_arguments "")
  if(_qctsm_libraries)
    string(APPEND _qctsm_deploy_arguments " ADDITIONAL_LIBRARIES${_qctsm_libraries}\n")
  endif()
  if(_qctsm_modules)
    string(APPEND _qctsm_deploy_arguments " ADDITIONAL_MODULES${_qctsm_modules}\n")
  endif()
  if(UNIX AND NOT APPLE AND _qctsm_excluded)
    string(APPEND _qctsm_deploy_arguments " POST_EXCLUDE_FILES${_qctsm_excluded}\n")
  endif()
  if(MSVC)
    string(APPEND _qctsm_deploy_arguments " NO_COMPILER_RUNTIME\n DEPLOY_TOOL_OPTIONS --exclude-plugins qpdf,qicns,qjp2,qdds,qtga,qtiff,qwbmp,qwebp,qmng\n")
  endif()
  if(APPLE)
    set(_qctsm_executable "qctsm-gui.app")
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_MACOS_CODESIGN_IDENTITY "-" CACHE STRING "macOS signing identity or '-' for ad-hoc")
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_MACOS_ENTITLEMENTS_MAP "" CACHE FILEPATH "Optional per-executable entitlements map")
    if(QCOPILOTS_TOOL_SEMANTIC_MATCHING_MACOS_CODESIGN_IDENTITY STREQUAL "")
      message(FATAL_ERROR "Select a macOS signing identity or '-' for ad-hoc")
    endif()
    set(_qctsm_identity "${QCOPILOTS_TOOL_SEMANTIC_MATCHING_MACOS_CODESIGN_IDENTITY}")
    string(REPLACE "\\" "\\\\" _qctsm_identity "${_qctsm_identity}")
    string(REPLACE "\"" "\\\"" _qctsm_identity "${_qctsm_identity}")
    string(REPLACE "$" "\\$" _qctsm_identity "${_qctsm_identity}")
    string(APPEND _qctsm_deploy_arguments " DEPLOY_TOOL_OPTIONS -no-codesign\n")
    set(_qctsm_deploy_prepare "include(\"${CMAKE_CURRENT_LIST_DIR}/qctsm-checked-deploy.cmake\")\n")
    set(_qctsm_deploy_finish "\nqctsm_verify_macos_links(\"\${QT_DEPLOY_PREFIX}/qctsm-gui.app\" \"${Python3_EXECUTABLE}\" \"${PROJECT_SOURCE_DIR}/tools/qctsm-verify-macos-links.py\" \"${CMAKE_BINARY_DIR}/../reports/qctsm-macos-links-$<CONFIG>.json\")\nqctsm_sign_macos_bundle(\"\${QT_DEPLOY_PREFIX}/qctsm-gui.app\" \"${Python3_EXECUTABLE}\" \"${PROJECT_SOURCE_DIR}/tools/qctsm-sign-macos.py\" \"${CMAKE_BINARY_DIR}/../reports/qctsm-macos-signing-$<CONFIG>.json\" \"${_qctsm_identity}\" \"${QCOPILOTS_TOOL_SEMANTIC_MATCHING_MACOS_ENTITLEMENTS_MAP}\")\nqctsm_verify_bundle_signature(\"\${QT_DEPLOY_PREFIX}/qctsm-gui.app\")\n")
  else()
    set(_qctsm_executable "$<TARGET_FILE:qctsm-gui>")
    set(_qctsm_deploy_prepare "")
    set(_qctsm_deploy_finish "")
  endif()
  qt_generate_deploy_script(TARGET qctsm-gui OUTPUT_SCRIPT _qctsm_deploy
    CONTENT "${_qctsm_deploy_prepare}qt_deploy_runtime_dependencies(\n EXECUTABLE \"${_qctsm_executable}\"\n ADDITIONAL_EXECUTABLES ${_qctsm_extra}\n${_qctsm_deploy_arguments} GENERATE_QT_CONF\n)${_qctsm_deploy_finish}")
  # Register after all helpers so macdeployqt can find the complete app bundle.
  if(APPLE)
    set(_qctsm_checked_deploy "include(\"${CMAKE_CURRENT_LIST_DIR}/qctsm-checked-deploy.cmake\")\nqctsm_checked_deploy(\"${_qctsm_deploy}\")")
  else()
    install(SCRIPT "${_qctsm_deploy}")
  endif()
endif()

include(qctsm-package-identity)
install(FILES "${CMAKE_BINARY_DIR}/qctsm-build-identity-$<CONFIG>.json"
  DESTINATION "${CMAKE_INSTALL_DATADIR}/qctsm" RENAME build-identity.json)
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md"
  "${PROJECT_SOURCE_DIR}/dependencies.lock.json" DESTINATION "${CMAKE_INSTALL_DATADIR}/qctsm")
install(FILES "${PROJECT_SOURCE_DIR}/config/build-variants.json"
  "${PROJECT_SOURCE_DIR}/config/qctsm-models.lock.json"
  "${PROJECT_SOURCE_DIR}/config/gpu-sdk.lock.json"
  "${PROJECT_SOURCE_DIR}/config/gpu-license-sources.lock.json"
  "${PROJECT_SOURCE_DIR}/tools/qt-packages.lock.json" DESTINATION "${CMAKE_INSTALL_DATADIR}/qctsm")
install(FILES "${PROJECT_SOURCE_DIR}/tests/runtime/fixtures/LICENSE-DigUp"
  "${CMAKE_CURRENT_LIST_DIR}/qctsm-model-terms.txt"
  DESTINATION "${CMAKE_INSTALL_DATADIR}/qctsm/licenses")
install(DIRECTORY "${PROJECT_SOURCE_DIR}/schemas/" DESTINATION "${CMAKE_INSTALL_DATADIR}/qctsm/schemas")
install(DIRECTORY "${PROJECT_SOURCE_DIR}/examples/" DESTINATION "${CMAKE_INSTALL_DATADIR}/qctsm/examples")
if(EXISTS "${PROJECT_SOURCE_DIR}/docs")
  install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/qctsm")
endif()
if(APPLE AND DEFINED _qctsm_checked_deploy)
  # Writing resources after signing invalidates the app seal.
  install(CODE "${_qctsm_checked_deploy}")
endif()

set(CPACK_PACKAGE_NAME "qctsm")
