include_guard(GLOBAL)
if(WIN32 AND NOT Python3_EXECUTABLE)
  find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
endif()
if(WIN32)
  file(TO_CMAKE_PATH "${Python3_EXECUTABLE}" Python3_EXECUTABLE)
endif()
set(_QCOPILOTS_TOOL_SEMANTIC_MATCHING_INSTALL_DIRECTORIES BINDIR SBINDIR LIBEXECDIR SYSCONFDIR
  SHAREDSTATEDIR LOCALSTATEDIR RUNSTATEDIR LIBDIR INCLUDEDIR OLDINCLUDEDIR
  DATAROOTDIR DATADIR INFODIR LOCALEDIR MANDIR DOCDIR)

# Resolve existing parent links as well as paths that do not exist yet. This
# check runs before creating application-owned caches, test roots or installs.
function(qctsm_package_require_external_path label path)
  if("${path}" STREQUAL "")
    message(FATAL_ERROR "${label} must name an external output directory")
  endif()
  if(ARGC GREATER 2)
    set(_source "${ARGV2}")
  else()
    set(_source "${CMAKE_SOURCE_DIR}")
  endif()
  file(REAL_PATH "${_source}" _source)
  get_filename_component(_path "${path}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  cmake_path(NORMAL_PATH _path)
  set(_existing "${_path}")
  set(_tail)
  while(NOT EXISTS "${_existing}" AND NOT IS_SYMLINK "${_existing}")
    cmake_path(GET _existing FILENAME _part)
    cmake_path(GET _existing PARENT_PATH _parent)
    if(_parent STREQUAL _existing OR _parent STREQUAL "")
      break()
    endif()
    list(PREPEND _tail "${_part}")
    set(_existing "${_parent}")
  endwhile()
  file(REAL_PATH "${_existing}" _resolved)
  foreach(_part IN LISTS _tail)
    cmake_path(APPEND _resolved "${_part}")
  endforeach()
  cmake_path(NORMAL_PATH _resolved)
  if(WIN32)
    # CMake 3.28 REAL_PATH does not resolve NTFS directory junctions. Python's
    # native Windows resolver follows reparse points, including parent links
    # of an output directory that has not been created yet.
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B -c
      "import json,pathlib,sys; print(json.dumps([pathlib.Path(p).resolve().as_posix() for p in sys.argv[1:]]))"
      "${_source}" "${_path}" RESULT_VARIABLE _status OUTPUT_VARIABLE _paths
      ERROR_VARIABLE _error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _status EQUAL 0)
      message(FATAL_ERROR "Cannot resolve ${label} output boundary: ${_error}")
    endif()
    string(JSON _source GET "${_paths}" 0)
    string(JSON _resolved GET "${_paths}" 1)
    string(TOLOWER "${_source}" _source)
    string(TOLOWER "${_resolved}" _resolved)
  endif()
  cmake_path(IS_PREFIX _source "${_resolved}" NORMALIZE _inside_source)
  if(_inside_source)
    message(FATAL_ERROR "${label} must be outside the source tree: ${path}")
  endif()
endfunction()

function(qctsm_validate_install_paths source)
  qctsm_package_require_external_path(CMAKE_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}" "${source}")
  foreach(_directory IN LISTS _QCOPILOTS_TOOL_SEMANTIC_MATCHING_INSTALL_DIRECTORIES)
    if(DEFINED CMAKE_INSTALL_${_directory} AND NOT "${CMAKE_INSTALL_${_directory}}" STREQUAL "")
      set(_destination "${CMAKE_INSTALL_${_directory}}")
      if(NOT IS_ABSOLUTE "${_destination}")
        set(_destination "${CMAKE_INSTALL_PREFIX}/${_destination}")
      endif()
      qctsm_package_require_external_path("CMAKE_INSTALL_${_directory}" "${_destination}" "${source}")
      if(NOT "$ENV{DESTDIR}" STREQUAL "")
        qctsm_package_require_external_path("DESTDIR/CMAKE_INSTALL_${_directory}" "$ENV{DESTDIR}${_destination}" "${source}")
      endif()
    endif()
  endforeach()
  if(NOT "$ENV{DESTDIR}" STREQUAL "")
    qctsm_package_require_external_path("DESTDIR/CMAKE_INSTALL_PREFIX" "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" "${source}")
  endif()
endfunction()

function(qctsm_install_output_guard source)
  qctsm_validate_install_paths("${source}")
  set(_qctsm_guard_source "${source}")
  set(_qctsm_guard_module "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set(_variables _qctsm_guard_source _qctsm_guard_module Python3_EXECUTABLE)
  foreach(_directory IN LISTS _QCOPILOTS_TOOL_SEMANTIC_MATCHING_INSTALL_DIRECTORIES)
    if(DEFINED CMAKE_INSTALL_${_directory})
      list(APPEND _variables CMAKE_INSTALL_${_directory})
    endif()
  endforeach()
  set(_code "")
  foreach(_variable IN LISTS _variables)
    # Bracket arguments preserve literal path characters in the generated script.
    set(_equals "")
    string(FIND "${${_variable}}" "]${_equals}]" _closing)
    while(NOT _closing EQUAL -1)
      string(APPEND _equals "=")
      string(FIND "${${_variable}}" "]${_equals}]" _closing)
    endwhile()
    string(APPEND _code "set(${_variable} [${_equals}[${${_variable}}]${_equals}])\n")
  endforeach()
  # Keep CMAKE_INSTALL_PREFIX dynamic so --prefix and DESTDIR are checked at
  # install time against the exact directories configured for each payload.
  string(APPEND _code "include(\"\${_qctsm_guard_module}\")\nqctsm_validate_install_paths(\"\${_qctsm_guard_source}\")")
  install(CODE "${_code}")
endfunction()
