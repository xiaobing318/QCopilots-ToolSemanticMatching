include_guard(GLOBAL)

# One manifest owns product IDs, toolkit versions and release coverage.
function(qctsm_select_variant)
  if(WIN32)
    set(_os windows)
  elseif(APPLE)
    set(_os macos)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_os linux)
  else()
    message(FATAL_ERROR "QCTSM has no supported build variant for ${CMAKE_SYSTEM_NAME}")
  endif()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
    set(_arch x64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
    set(_arch arm64)
  else()
    message(FATAL_ERROR "QCTSM has no supported build variant for ${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  if(_os STREQUAL "macos")
    set(_default "${_os}-${_arch}-metal")
  else()
    set(_default "${_os}-${_arch}-cpu")
  endif()
  set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT "${_default}" CACHE STRING "Product build variant from config/build-variants.json")
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/build-variants.json" _manifest)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config/gpu-sdk.lock.json" _sdk_lock)
  string(JSON _upstream GET "${_manifest}" upstream commit)
  string(JSON _sdk_upstream GET "${_sdk_lock}" upstreamCommit)
  if(NOT _upstream STREQUAL _sdk_upstream)
    message(FATAL_ERROR "Build variants and GPU SDK lock must identify the same upstream commit")
  endif()
  string(JSON _count LENGTH "${_manifest}" variants)
  math(EXPR _last "${_count} - 1")
  set(_found OFF)
  set(_ids)
  foreach(_index RANGE 0 ${_last})
    string(JSON _id GET "${_manifest}" variants ${_index} id)
    list(APPEND _ids "${_id}")
    if(NOT _id STREQUAL QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT)
      continue()
    endif()
    set(_found ON)
    foreach(_field os arch backend toolkitVersion packageVariant)
      string(JSON _${_field} GET "${_manifest}" variants ${_index} ${_field})
    endforeach()
    set(_expected_package_variant "${_id}")
    if(_backend STREQUAL "hip" OR _backend STREQUAL "vulkan")
      if(NOT _toolkitVersion MATCHES "^[0-9]+(\\.[0-9]+)+$")
        message(FATAL_ERROR "Variant ${_id} requires a concrete toolkit version")
      endif()
      string(APPEND _expected_package_variant "-${_toolkitVersion}")
      if(_backend STREQUAL "hip")
        string(JSON _locked_version GET "${_sdk_lock}" rocm ${_os} version)
      elseif(_os STREQUAL "linux")
        string(JSON _locked_version GET "${_sdk_lock}" vulkan ${_os} sdkVersion)
      else()
        string(JSON _locked_version GET "${_sdk_lock}" vulkan ${_os} version)
      endif()
      if(NOT _toolkitVersion STREQUAL _locked_version)
        message(FATAL_ERROR "Variant ${_id} toolkit version does not match the GPU SDK lock")
      endif()
    elseif(_backend STREQUAL "cuda")
      string(JSON _locked_cuda TYPE "${_sdk_lock}" cuda ${_os} ${_toolkitVersion})
      if(NOT _locked_cuda STREQUAL "OBJECT")
        message(FATAL_ERROR "Variant ${_id} toolkit version is absent from the GPU SDK lock")
      endif()
    endif()
    if(NOT _packageVariant STREQUAL _expected_package_variant)
      message(FATAL_ERROR "Variant ${_id} packageVariant does not match its locked toolkit version")
    endif()
    if(WIN32 AND NOT _os STREQUAL "windows" OR APPLE AND NOT _os STREQUAL "macos"
       OR CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT _os STREQUAL "linux")
      message(FATAL_ERROR "Variant ${_id} cannot be built for ${CMAKE_SYSTEM_NAME}")
    endif()
    if(_arch STREQUAL "x64" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$"
       OR _arch STREQUAL "arm64" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
      message(FATAL_ERROR "Variant ${_id} requires ${_arch}, got ${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    string(JSON _targets_count LENGTH "${_manifest}" variants ${_index} gpuTargets)
    set(_targets)
    if(_targets_count GREATER 0)
      math(EXPR _targets_last "${_targets_count} - 1")
      foreach(_target_index RANGE 0 ${_targets_last})
        string(JSON _target GET "${_manifest}" variants ${_index} gpuTargets ${_target_index})
        list(APPEND _targets "${_target}")
      endforeach()
    endif()
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_BACKEND "${_backend}" PARENT_SCOPE)
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_TOOLKIT_VERSION "${_toolkitVersion}" PARENT_SCOPE)
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_GPU_TARGETS "${_targets}" PARENT_SCOPE)
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT_ARCH "${_arch}" PARENT_SCOPE)
    # Selection runs in src/runtime, while CPack is configured at project scope.
    set(QCOPILOTS_TOOL_SEMANTIC_MATCHING_PACKAGE_VARIANT "${_packageVariant}" CACHE INTERNAL
      "Package filename identity selected by the product variant" FORCE)
  endforeach()
  set_property(CACHE QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT PROPERTY STRINGS ${_ids})
  if(NOT _found)
    message(FATAL_ERROR "Unknown QCTSM build variant: ${QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT}. Choose one of: ${_ids}")
  endif()
  message(STATUS "QCTSM variant: ${QCOPILOTS_TOOL_SEMANTIC_MATCHING_VARIANT}")
endfunction()
